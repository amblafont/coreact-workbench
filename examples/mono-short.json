      "rocqProof": "Lemma MonoStart_rule : forall (a b c : Vertex)(m : Edge a b)(n : Edge b c)(mn : Edge a c)(Triangle_2 : Triangle m n mn)(isMono_2 : isMono m)(isMono_3 : isMono n), isMono mn.\nintros_sigma ().\nassert (Hpremise1 : forall (x : Vertex)(f g : Edge x a)(h : Edge x c)(fm : Triangle f mn h)(gm : Triangle g mn h), f = g). {\n  intros_sigma ().\n  destruct_sigma (@Comp_rule x a b f m) as fm_2 Triangle_3.\n  destruct_sigma (@Comp_rule x a b g m) as gm_2 Triangle_4.\n  destruct_sigma (@Comp_rule x b c fm_2 n) as fmn Triangle_5.\n  destruct_sigma (@Assoc_rule x a b c f m n fm_2 fmn mn h Triangle_3 Triangle_5 Triangle_2 fm) as _.\n  destruct_sigma (@Comp_rule x b c gm_2 n) as gmn Triangle_6.\n  destruct_sigma (@Assoc_rule x a b c g m n gm_2 gmn mn h Triangle_4 Triangle_6 Triangle_2 gm) as _.\n  destruct_sigma (@Mono2___Premise__reverse__rule b c x n fm_2 gm_2 h Triangle_5 Triangle_6 isMono_3) as _.\n  destruct_sigma (@Mono2___Premise__reverse__rule a b x m f g fm_2 Triangle_3 Triangle_4 isMono_2) as _.\n  exact eq_refl.\n}\ndestruct_sigma (@Mono2_rule a c mn Hpremise1) as isMono_5.\nexact isMono_5.\nQed.\n",
      "abellaProof": "Theorem MonoStart_rule : forall a b c m n mn Triangle_2 isMono_2 isMono_3, vertex a -> vertex b -> vertex c -> edge a b m -> edge b c n -> edge a c mn -> triangle m n mn Triangle_2 -> isMono m isMono_2 -> isMono n isMono_3 -> exists isMono_4, isMono mn isMono_4.\nskip."
