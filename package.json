{
  "name": "coreact2",
  "version": "1.0.0",
  "description": "JS library for drawing SVG shapes, with data. API based on d3.js.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run build:sorts",
    "build": "vite build",
    "build:standalone": "SINGLEFILE=true vite build",
    "prebuild": "npm run build:sorts",
    "build:sorts": "tsc src/default_sorts.ts --target esnext --moduleResolution node --outDir src/generated",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "pretest": "npm run build:sorts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/d3": "^7.4.3",
    "happy-dom": "^20.14.5",
    "puppeteer": "^24.43.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "d3": "^7.8.0"
  }
}
